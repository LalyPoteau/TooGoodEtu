<header>
<h1> A sauver aujourd'hui </h1>
</header>

<?php $__currentLoopData = $panierdujour; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $panier=>$info): $loop = $this->incrementLoopIndices();  ?>
<a href="index.php?page=visupanier&index=<?php echo \htmlentities($info['id']??'', ENT_QUOTES, 'UTF-8', false); ?>">
<div class=panier>
 <span class="etiquette"><?php echo \htmlentities($info['intitule']??'', ENT_QUOTES, 'UTF-8', false); ?> </span>
 <img src="<?php echo \htmlentities(URL_PUBLIC??'', ENT_QUOTES, 'UTF-8', false); ?><?php echo \htmlentities($info['img_url']??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <h2> <?php echo \htmlentities($info['nom']??'', ENT_QUOTES, 'UTF-8', false); ?> </h2>
 <span> à récupérer le <?php echo \htmlentities($info['dateRetrait']??'', ENT_QUOTES, 'UTF-8', false); ?>

 : <?php echo \htmlentities($info['heureDebut']??'', ENT_QUOTES, 'UTF-8', false); ?> - <?php echo \htmlentities($info['heureFin']??'', ENT_QUOTES, 'UTF-8', false); ?> </span>
 <p> <?php echo \htmlentities($info['prix']??'', ENT_QUOTES, 'UTF-8', false); ?> € </p>
</div>
</a>
<?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>


